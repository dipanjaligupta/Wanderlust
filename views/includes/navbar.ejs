<style>
  /* Search styling */
  .search-form {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    width: 100%;
    max-width: 420px;
    margin: 0 auto;
  }

  .search-inp {
    flex: 1 1 auto;
    min-width: 0;
    width: 100%;
    border-radius: 25px;
    padding: 0.55rem 1rem;
    font-size: 0.95rem;
  }

  .search-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    background-color: #fe424d;
    color: #fff;
    border: none;
    border-radius: 25px;
    padding: 0.6rem 1rem;
    white-space: nowrap;
  }

  .search-btn:hover,
  .search-btn:focus {
    background-color: #e93843;
    color: #fff;
  }

  .search-btn i {
    margin-right: 0.4rem;
  }

  /* Navbar layout */
  .navbar {
    min-height: 5rem;
    height: auto;
    padding: 0.6rem 1rem;
    background-color: #fff;
  }

  .navbar .container-fluid {
    gap: 0.5rem;
  }

  .navbar-brand {
    flex-shrink: 0;
  }

  .navbar-collapse {
    align-items: center;
  }

  .navbar-collapse .navbar-nav {
    align-items: center;
  }

  /* Desktop */
  @media (min-width: 768px) {
    .search-form {
      width: min(100%, 360px);
    }

    .navbar-collapse {
      gap: 1rem;
    }

    .navbar-collapse > .navbar-nav:last-child {
      margin-left: auto;
    }
  }

  /* Mobile and tablet */
  @media (max-width: 767.98px) {
    .navbar {
      padding: 0.65rem 0.75rem;
    }

    .navbar .container-fluid {
      padding: 0;
    }

    .navbar-collapse {
      flex-basis: 100%;
      width: 100%;
      padding: 1rem 0 0.5rem;
    }

    .navbar-collapse .navbar-nav {
      align-items: stretch;
      width: 100%;
      margin-left: 0 !important;
    }

    /* Search gets its own full-width row */
    .navbar-collapse .navbar-nav:has(#searchForm) {
      margin: 0.75rem 0 !important;
    }

    .search-form {
      width: 100%;
      max-width: none;
      gap: 0.4rem;
    }

    .search-inp {
      flex: 1 1 0;
      width: 0;
      min-width: 0;
      padding: 0.55rem 0.75rem;
      font-size: 0.9rem;
    }

    .search-btn {
      padding: 0.6rem 0.8rem;
      font-size: 0.9rem;
    }

    .navbar-collapse .nav-link {
      padding: 0.6rem 0;
    }
  }
  
/* Mobile navbar fix */
@media (max-width: 767px) {
  .navbar {
    height: auto !important;
    min-height: 4.5rem;
    padding: 0.75rem;
  }

  .navbar > .container-fluid {
    display: flex;
    flex-wrap: wrap;
    width: 100%;
    padding: 0;
  }

  .navbar-brand {
    margin-right: auto;
  }

  .navbar-toggler {
    flex-shrink: 0;
  }

  #navbarNavAltMarkup {
    flex-basis: 100%;
    width: 100%;
    min-width: 0;
    padding-top: 1rem;
  }

  #navbarNavAltMarkup .navbar-nav {
    width: 100%;
    margin-left: 0 !important;
    align-items: stretch;
  }

  #navbarNavAltMarkup #searchForm {
    display: flex;
    width: 100%;
    max-width: 100%;
    min-width: 0;
    gap: 8px;
  }

  #navbarNavAltMarkup .search-inp {
    flex: 1 1 0;
    width: 0;
    min-width: 0;
    padding: 0.6rem 0.75rem;
    font-size: 14px;
  }

  #navbarNavAltMarkup .search-btn {
    flex-shrink: 0;
    padding: 0.6rem 0.8rem;
    font-size: 14px;
  }

  #navbarNavAltMarkup .nav-link {
    padding: 0.65rem 0;
    white-space: normal;
  }
}



</style>

<nav class="navbar navbar-expand-md navbar-light bg-body-light border-bottom sticky-top">
  <div class="container-fluid">

    <!-- LOGO -->
    <a class="navbar-brand" href="/listings" aria-label="Wanderlust home">
      <i class="fa-regular fa-compass"></i>
    </a>

    <!-- MOBILE TOGGLE -->
    <button
      class="navbar-toggler"
      type="button"
      data-bs-toggle="collapse"
      data-bs-target="#navbarNavAltMarkup"
      aria-controls="navbarNavAltMarkup"
      aria-expanded="false"
      aria-label="Toggle navigation"
    >
      <span class="navbar-toggler-icon"></span>
    </button>

    <div class="collapse navbar-collapse" id="navbarNavAltMarkup">

      <!-- EXPLORE -->
      <div class="navbar-nav">
        <a class="nav-link" href="/listings">Explore</a>
      </div>

      <!-- SEARCH -->
      <div class="navbar-nav ms-auto">
        <form
          action="/listings"
          method="GET"
          class="search-form"
          id="searchForm"
          role="search"
        >
          <input
            class="form-control search-inp"
            type="search"
            name="search"
            id="searchInput"
            placeholder="Search destinations"
            aria-label="Search destinations"
            value="<%= typeof search !== 'undefined' ? search : '' %>"
          >

          <button class="btn search-btn" type="submit">
            <i class="fa-solid fa-magnifying-glass"></i>
            Search
          </button>
        </form>
      </div>

      <!-- RIGHT SIDE LINKS -->
      <div class="navbar-nav ms-auto">
        <a class="nav-link" href="/listings/new">
          Airbnb your home
        </a>

        <% if (!currUser) { %>
          <a class="nav-link" href="/signup">
            <b>Sign Up</b>
          </a>

          <a class="nav-link" href="/login">
            <b>Log in</b>
          </a>
        <% } %>

        <% if (currUser) { %>
          <a class="nav-link" href="/logout">
            <b>Logout</b>
          </a>
        <% } %>
      </div>

    </div>
  </div>
</nav>

<script>
  const searchInput = document.getElementById("searchInput");

  if (searchInput) {
    searchInput.addEventListener("search", function () {
      if (this.value.trim() === "") {
        window.location.href = "/listings";
      }
    });
  }
</script>