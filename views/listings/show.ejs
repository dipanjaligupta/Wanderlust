<% layout("/layouts/boilerplate") %>

<div class="row mt-3">

  <!-- ================= LISTING TITLE ================= -->

  <div class="col-8 offset-2">
    <h3><%= listing.title %></h3>
  </div>


  <!-- ================= LISTING CARD ================= -->

  <div class="card col-6 offset-2 show-card listing-card">

    <img
      src="<%= listing.image.url %>"
      class="card-img-top show-img"
      alt="listing_image"
    >

    <div class="card-body">

      <p class="card-text">
        Owner by :
        <i><%= listing.owner.username %></i>
      </p>

      <p class="card-text">
        <%= listing.description %>
      </p>

      <p class="card-text">
        ₹<%= listing.price.toLocaleString("en-IN") %>
      </p>

      <p class="card-text">
        <%= listing.location %>
      </p>

      <p class="card-text">
        <%= listing.country %>
      </p>

    </div>

  </div>


  <!-- ================= EDIT DELETE ================= -->

  <% if(currUser && listing.owner._id.equals(currUser._id)) { %>

    <div class="col-8 offset-2 d-flex gap-2 my-3">

      <a
        href="/listings/<%= listing._id %>/edit"
        class="btn edit-btn"
      >
        Edit
      </a>

      <form
        method="POST"
        action="/listings/<%= listing._id %>?_method=DELETE"
      >

        <button class="btn delete-btn">
          Delete
        </button>

      </form>

    </div>

  <% } %>


  <!-- ================= REVIEW FORM ================= -->

  <% if(currUser) { %>

    <div class="col-8 offset-2 mb-3">

      <h4>Leave a Review</h4>

      <form
        action="/listings/<%= listing._id %>/reviews"
        method="POST"
        novalidate
        class="needs-validation"
      >

        <!-- Rating -->

        <div class="mb-3 mt-3">

          <label class="form-label">
            Rating
          </label>

          <fieldset class="starability-slot">

            <input
              type="radio"
              id="no-rate"
              class="input-no-rate"
              name="review[rating]"
              value="1"
              checked
              aria-label="No rating."
            />

            <input
              type="radio"
              id="first-rate1"
              name="review[rating]"
              value="1"
            />

            <label
              for="first-rate1"
              title="Terrible"
            >
              1 star
            </label>


            <input
              type="radio"
              id="first-rate2"
              name="review[rating]"
              value="2"
            />

            <label
              for="first-rate2"
              title="Not good"
            >
              2 stars
            </label>


            <input
              type="radio"
              id="first-rate3"
              name="review[rating]"
              value="3"
            />

            <label
              for="first-rate3"
              title="Average"
            >
              3 stars
            </label>


            <input
              type="radio"
              id="first-rate4"
              name="review[rating]"
              value="4"
            />

            <label
              for="first-rate4"
              title="Very good"
            >
              4 stars
            </label>


            <input
              type="radio"
              id="first-rate5"
              name="review[rating]"
              value="5"
            />

            <label
              for="first-rate5"
              title="Amazing"
            >
              5 stars
            </label>

          </fieldset>

        </div>


        <!-- Comment -->

        <div class="mb-3 mt-3">

          <label
            for="comment"
            class="form-label"
          >
            Comments
          </label>

          <textarea
            name="review[comment]"
            id="comment"
            cols="30"
            rows="5"
            class="form-control"
            required
          ></textarea>

          <div class="invalid-feedback">
            Please submit some comments.
          </div>

        </div>


        <button class="btn btn-outline-dark">
          Submit
        </button>

      </form>

    </div>

  <% } %>


  <!-- ================= MAP ================= -->

  <div class="col-8 offset-2 mb-4">

    <h4 class="mb-3">
      Where you'll be
    </h4>

    <div id="map"></div>

  </div>


  <!-- ================= ALL REVIEWS ================= -->

  <div class="col-8 offset-2">

    <hr>

    <% if(listing.reviews.length > 0) { %>

      <div class="row">

        <p class="mb-3">
          <b>All Reviews</b>
        </p>


        <% for(review of listing.reviews) { %>

          <div class="card col-5 m-2 mb-3">

            <div class="card-body">

              <h5 class="card-title">
                @<%= review.author.username %>
              </h5>

              <p
                class="starability-result"
                data-rating="<%= review.rating %>"
              >
              </p>

              <p class="card-text">
                <%= review.comment %>
              </p>

            </div>


            <form
              class="mb-4"
              method="POST"
              action="/listings/<%= listing._id %>/reviews/<%= review._id %>?_method=DELETE"
            >

              <button class="btn btn-sm delete-btn">
                Delete
              </button>

            </form>

          </div>

        <% } %>

      </div>

    <% } %>

  </div>

</div>


<!-- ================================================= -->
<!-- MAPLIBRE CSS -->
<!-- ================================================= -->

<link
  rel="stylesheet"
  href="https://unpkg.com/maplibre-gl@4.7.1/dist/maplibre-gl.css"
/>


<!-- ================================================= -->
<!-- MAPLIBRE JS -->
<!-- ================================================= -->

<script src="https://unpkg.com/maplibre-gl@4.7.1/dist/maplibre-gl.js"></script>


<!-- ================================================= -->
<!-- MAP SCRIPT -->
<!-- ================================================= -->

<script>

  console.log("Map script started");


  // Default coordinates
  // [longitude, latitude]
  let coordinates = [78.9629, 20.5937];


  // If listing has coordinates,
  // use those coordinates
  <% if (listing.geometry && listing.geometry.coordinates) { %>

    coordinates =
      <%- JSON.stringify(listing.geometry.coordinates) %>;

  <% } %>


  console.log("Listing coordinates:", coordinates);


  // Check MapLibre
  if (typeof maplibregl === "undefined") {

    console.error("MapLibre could not be loaded.");

  } else {

    console.log("MapLibre loaded successfully.");


    // ================= CREATE MAP =================

    const map = new maplibregl.Map({

      container: "map",

      style: {

        version: 8,

        sources: {

          osm: {

            type: "raster",

            tiles: [
              "https://tile.openstreetmap.org/{z}/{x}/{y}.png"
            ],

            tileSize: 256,

            attribution:
              "&copy; OpenStreetMap contributors"

          }

        },

        layers: [

          {

            id: "osm",

            type: "raster",

            source: "osm"

          }

        ]

      },

      center: coordinates,

      zoom: 10

    });


    // ================= NAVIGATION =================

    map.addControl(
      new maplibregl.NavigationControl(),
      "top-right"
    );


    // ================= MARKER =================

    const marker =
      new maplibregl.Marker()
        .setLngLat(coordinates)
        .addTo(map);


    // ================= POPUP =================

    marker.setPopup(

      new maplibregl.Popup({
        offset: 25
      })

      .setHTML(`

        <h5>
          <%= listing.title %>
        </h5>

        <p>
          <%= listing.location %>
        </p>

      `)

    );


    console.log("Map created successfully.");

  }

</script>